# =================================================================
# KneeAI – Docker / EC2 Runtime Environment
# Copy this file to .env.docker on the EC2 host and fill in values
# This file is safe to commit (no secrets – secrets use placeholders)
# =================================================================

KNEEAI_ENV=production
KNEEAI_LOG_LEVEL=INFO

# Storage (container-internal paths)
KNEEAI_DATA_ROOT=/app/data
KNEEAI_ARTIFACT_ROOT=/app/artifacts

# Database – SQLite for single-node EC2 deployment
KNEEAI_DATABASE_URL=sqlite:///./artifacts/kneeai.db

# Redis (disabled for minimal EC2 – enable if you add a redis service)
KNEEAI_REDIS_URL=redis://localhost:6379/0

# API
KNEEAI_API_HOST=0.0.0.0
KNEEAI_API_PORT=8000
# IMPORTANT: generate a real secret before any real deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KNEEAI_JWT_SECRET=CHANGE-ME-BEFORE-DEPLOYING-generate-with-secrets-token-urlsafe-48

# CORS – set to your EC2 public IP or domain
KNEEAI_CORS_ORIGINS=http://localhost:3000,http://0.0.0.0:3000

# Model paths
KNEEAI_MODEL_REGISTRY=/app/models
KNEEAI_MLFLOW_TRACKING_URI=/app/artifacts/mlruns

# Implant catalog
KNEEAI_IMPLANT_CATALOG=builtin:reference-v0
KNEEAI_ALLOW_NONCLINICAL_IMPLANTS=true

# Frontend – replace with your actual EC2 public IP or DNS
NEXT_PUBLIC_API_URL=http://localhost:8000

# Copy to .env and fill in. Never commit .env.

# --- Environment ---------------------------------------------------------
KNEEAI_ENV=development           # development | staging | production
KNEEAI_LOG_LEVEL=INFO

# --- Storage -------------------------------------------------------------
# Root for all case artefacts (DICOM, masks, meshes, plans, reports).
# Treat as patient data: encrypted volume, access controlled (PRD §81).
KNEEAI_DATA_ROOT=./data
KNEEAI_ARTIFACT_ROOT=./artifacts

# --- Database ------------------------------------------------------------
# SQLite is fine for local development; Postgres for anything shared.
KNEEAI_DATABASE_URL=sqlite:///./artifacts/kneeai.db
# KNEEAI_DATABASE_URL=postgresql+psycopg://kneeai:kneeai_dev_only@localhost:5432/kneeai

# --- Queue ---------------------------------------------------------------
KNEEAI_REDIS_URL=redis://localhost:6379/0

# --- API -----------------------------------------------------------------
KNEEAI_API_HOST=127.0.0.1
KNEEAI_API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KNEEAI_JWT_SECRET=change-me-before-any-shared-deployment
KNEEAI_JWT_TTL_MINUTES=60
KNEEAI_CORS_ORIGINS=http://localhost:3000

# --- DICOM store ---------------------------------------------------------
KNEEAI_ORTHANC_URL=http://localhost:8042
KNEEAI_ORTHANC_USER=kneeai
KNEEAI_ORTHANC_PASSWORD=kneeai_dev_only

# --- Model registry ------------------------------------------------------
KNEEAI_MODEL_REGISTRY=./artifacts/models
KNEEAI_MLFLOW_TRACKING_URI=./mlruns

# --- Implant catalog -----------------------------------------------------
# The bundled catalog is a NON-CLINICAL reference geometry set for development.
# Commercial deployment requires authorized manufacturer geometry (PRD §21).
KNEEAI_IMPLANT_CATALOG=builtin:reference-v0
KNEEAI_ALLOW_NONCLINICAL_IMPLANTS=true

# --- LLM explanation layer ----------------------------------------------
# The LLM is an explanation/reporting layer only. It is architecturally
# forbidden from the safety loop (PRD §116, §117).
KNEEAI_LLM_ENABLED=false
KNEEAI_LLM_PROVIDER=none
KNEEAI_LLM_MODEL=
KNEEAI_LLM_API_KEY=

# --- Web frontend --------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
